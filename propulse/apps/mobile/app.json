{
  "expo": {
    "name": "PROPULSE",
    "slug": "propulse",
    "scheme": "propulse",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "ios": {
      "bundleIdentifier": "app.propulse.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.propulse.mobile"
    }
  }
}
